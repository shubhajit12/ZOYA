{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zoya",
  "version": "1.0.0",
  "identifier": "com.zoya.aicompanion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ZOYA AI Companion",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "resources": [
      "companion-engine/bin/ZOYA.CompanionEngine.exe",
      "mate-companion/**/*",
      "server/**/*",
      "minecraft-bridge/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
