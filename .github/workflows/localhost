name: Localhost

on:
  workflow_dispatch:

jobs:
  build-windows:
    runs-on: windows-latest

    defaults:
      run:
        working-directory: zoya-ai-companion-MAIN

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 24

      - name: Install dependencies
        run: npm install

      - name: Start Localhost Server in Background
        # 'Start-Process' is required on Windows runner to prevent hanging
        run: Start-Process npm -ArgumentList "run dev" -NoNewWindow

      - name: Wait for Localhost:3000 to be Ready
        # This will ping the port until it responds, ensuring your app is fully up
        run: npx wait-on http://localhost:3000 --timeout 60000

      - name: Run Tests against Localhost
        run: |
          echo "Localhost:3000 is live inside the Windows runner!"
          # Replace the line below with your actual test command (e.g., npm run test)
          npm run test 

