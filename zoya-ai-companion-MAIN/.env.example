# GROQ_API_KEY: Primary AI Brain for conversational chat, reasoning & emotion inference.
GROQ_API_KEY="gsk_..."

# GEMINI_API_KEY: General Gemini API key (used for fallback brain & general Gemini features).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_TTS_API_KEY: Optional dedicated API key exclusively for Google Gemini Text-to-Speech (TTS).
# Having a separate key isolates TTS voice quota from the AI brain quota.
GEMINI_TTS_API_KEY="MY_GEMINI_TTS_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
