# GROQ_API_KEY: Primary AI Brain for conversational chat, reasoning & emotion inference.
GROQ_API_KEY="gsk_..."

# GEMINI_API_KEY: General Gemini API key (used for fallback brain & general Gemini features).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# FISH_API_KEY: Fish Audio TTS API key.
FISH_API_KEY="YOUR_FISH_API_KEY"

# FISH_VOICE_REFERENCE_ID: Fish Audio voice reference ID.
FISH_VOICE_REFERENCE_ID="cbe13152c7ff4da98be9a95d448a1f39"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
